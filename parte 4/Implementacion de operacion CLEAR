.include "m328pdef.inc"

.org 0x0000
    rjmp RESET

RESET:

    ldi r16, high(RAMEND)
    out SPH, r16

    ldi r16, low(RAMEND)
    out SPL, r16

    ldi r16, 0x00
    out DDRD, r16

    ldi r16, 0b00111000
    out DDRB, r16

    ldi r16, 0b00001111
    out DDRC, r16


MAIN:

    in r16, PIND

    ; A
    mov r18, r16
    andi r18, 0x0F

    ; B
    swap r16
    andi r16, 0x0F
    mov r19, r16

    ; Seleccion
    in r17, PINB
    andi r17, 0x07

    ; S = 0 -> CLEAR
    cpi r17, 0
    breq CLEAR

    rjmp MAIN


CLEAR:

    clr r20

    rjmp MAIN
